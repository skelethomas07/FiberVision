# Backend
DATABASE_URL=postgresql+psycopg://semfiber:semfiber@postgres:5432/semfiber
REDIS_URL=redis://redis:6379/0
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=semfiber
S3_SECRET_KEY=change-me
S3_BUCKET=sem-fiber
S3_REGION=us-east-1
MODEL_CHECKPOINT=/models/model.pt
MODEL_VERSION=v6.11
MODEL_DEVICE=auto
