# Backend
DATABASE_URL=postgresql+psycopg://semfiber:semfiber@postgres:5432/semfiber
REDIS_URL=redis://redis:6379/0
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=semfiber
S3_SECRET_KEY=change-me
S3_BUCKET=sem-fiber
S3_REGION=us-east-1
MODEL_CHECKPOINT=/models/v6_12/best_full.pt
MODEL_VERSION=v6.12
MODEL_DEVICE=auto
WORK_DIR=/work
FRONTEND_ORIGIN=http://localhost:3000

# Frontend build-time public API address
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Authentication
AUTH_SESSION_DAYS=7
AUTH_COOKIE_NAME=fibervision_session
# Keep false for the current HTTP/IP deployment. Set true after HTTPS is enabled.
AUTH_COOKIE_SECURE=false
