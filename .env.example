WIDTH_CALIBRATION_PATH=
CALIBRATION_TABLE_PATH=
WORK_DIR=/work
FRONTEND_ORIGIN=http://localhost:3000

# Frontend build-time public API address
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
